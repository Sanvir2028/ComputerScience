    multiplayerMode = input("Player One please input a password for Player Two to Guess!: ")
    
if playerAmount == "one":
    print("Proceeding... \n")

elif playerAmount == "two":
    multiplayer = True
    multi()
else:
    print("Please choose either one/two: ")
